<!--
name: pronunciation_dic.pls
description: W3C PLS Pronunciation Lexicon for Banking CSKH & Debt Collection Voicebot/Chatbot.
-->
<?xml version="1.0" encoding="UTF-8"?>
<lexicon version="1.0" 
  xmlns="http://www.w3.org/2005/01/pronunciation-lexicon" 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
  xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon 
  http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd" 
  alphabet="ipa" xml:lang="vi-VN">

  <!-- ========================================== -->
  <!-- 1. IDENTITY & SECURITY                     -->
  <!-- ========================================== -->
  
  <!-- Identity Card Abbreviation (CCCD) -->
  <lexeme>
    <grapheme>CCCD</grapheme>
    <alias>Căn cước công dân</alias>
  </lexeme>
  <lexeme>
    <grapheme>cccd</grapheme>
    <alias>căn cước công dân</alias>
  </lexeme>

  <!-- One-Time Password (OTP) -->
  <lexeme>
    <grapheme>OTP</grapheme>
    <alias>Ô tê pê</alias>
  </lexeme>
  <lexeme>
    <grapheme>otp</grapheme>
    <alias>ô tê pê</alias>
  </lexeme>

  <!-- Card Verification Value (CVV/CVC) -->
  <lexeme>
    <grapheme>CVV</grapheme>
    <alias>xi vi vi</alias>
  </lexeme>
  <lexeme>
    <grapheme>cvv</grapheme>
    <alias>xi vi vi</alias>
  </lexeme>
  <lexeme>
    <grapheme>CVC</grapheme>
    <alias>xi vi xi</alias>
  </lexeme>
  <lexeme>
    <grapheme>cvc</grapheme>
    <alias>xi vi xi</alias>
  </lexeme>


  <!-- ========================================== -->
  <!-- 2. BRAND & CURRENCY                        -->
  <!-- ========================================== -->

  <!-- Brand Names -->
  <lexeme>
    <grapheme>SacomBank</grapheme>
    <alias>Ngân hàng SacomBank</alias>
  </lexeme>
  <lexeme>
    <grapheme>sacombank</grapheme>
    <alias>ngân hàng SacomBank</alias>
  </lexeme>
  <lexeme>
    <grapheme>ABB</grapheme>
    <alias>Ngân hàng SacomBank</alias>
  </lexeme>
  <lexeme>
    <grapheme>abb</grapheme>
    <alias>ngân hàng SacomBank</alias>
  </lexeme>

  <!-- Currency (VND/VNĐ) -->
  <lexeme>
    <grapheme>VND</grapheme>
    <alias>đồng</alias>
  </lexeme>
  <lexeme>
    <grapheme>vnd</grapheme>
    <alias>đồng</alias>
  </lexeme>
  <lexeme>
    <grapheme>VNĐ</grapheme>
    <alias>đồng</alias>
  </lexeme>
  <lexeme>
    <grapheme>vnđ</grapheme>
    <alias>đồng</alias>
  </lexeme>


  <!-- ========================================== -->
  <!-- 3. PAYMENT & CARD BRANDS                   -->
  <!-- ========================================== -->

  <!-- Visa -->
  <lexeme>
    <grapheme>Visa</grapheme>
    <alias>Vi-da</alias>
  </lexeme>
  <lexeme>
    <grapheme>visa</grapheme>
    <alias>vi-da</alias>
  </lexeme>

  <!-- Mastercard -->
  <lexeme>
    <grapheme>Mastercard</grapheme>
    <alias>Mát-tơ-cạc</alias>
  </lexeme>
  <lexeme>
    <grapheme>mastercard</grapheme>
    <alias>mát-tơ-cạc</alias>
  </lexeme>

  <!-- JCB -->
  <lexeme>
    <grapheme>JCB</grapheme>
    <alias>Giây xi bi</alias>
  </lexeme>
  <lexeme>
    <grapheme>jcb</grapheme>
    <alias>giây xi bi</alias>
  </lexeme>

  <!-- Napas -->
  <lexeme>
    <grapheme>Napas</grapheme>
    <alias>Na-pát</alias>
  </lexeme>
  <lexeme>
    <grapheme>napas</grapheme>
    <alias>na-pát</alias>
  </lexeme>


  <!-- ========================================== -->
  <!-- 4. COMMUNICATION & CHANNELS                -->
  <!-- ========================================== -->

  <!-- SMS -->
  <lexeme>
    <grapheme>SMS</grapheme>
    <alias>ét-em-ét</alias>
  </lexeme>
  <lexeme>
    <grapheme>sms</grapheme>
    <alias>ét-em-ét</alias>
  </lexeme>

  <!-- Zalo & ZNS -->
  <lexeme>
    <grapheme>Zalo</grapheme>
    <alias>da-lô</alias>
  </lexeme>
  <lexeme>
    <grapheme>zalo</grapheme>
    <alias>da-lô</alias>
  </lexeme>
  <lexeme>
    <grapheme>ZNS</grapheme>
    <alias>dét-nờ-ét</alias>
  </lexeme>
  <lexeme>
    <grapheme>zns</grapheme>
    <alias>dét-nờ-ét</alias>
  </lexeme>


  <!-- ========================================== -->
  <!-- 5. TECHNICAL & BUSINESS TERMS              -->
  <!-- ========================================== -->

  <!-- API -->
  <lexeme>
    <grapheme>API</grapheme>
    <alias>a-pi</alias>
  </lexeme>
  <lexeme>
    <grapheme>api</grapheme>
    <alias>a-pi</alias>
  </lexeme>

  <!-- CRM -->
  <lexeme>
    <grapheme>CRM</grapheme>
    <alias>xi-a-rem</alias>
  </lexeme>
  <lexeme>
    <grapheme>crm</grapheme>
    <alias>xi-a-rem</alias>
  </lexeme>

  <!-- SIP (Session Initiation Protocol) -->
  <lexeme>
    <grapheme>SIP</grapheme>
    <alias>síp</alias>
  </lexeme>
  <lexeme>
    <grapheme>sip</grapheme>
    <alias>síp</alias>
  </lexeme>

  <!-- PTP (Promise to Pay) -->
  <lexeme>
    <grapheme>PTP</grapheme>
    <alias>cam kết thanh toán</alias>
  </lexeme>
  <lexeme>
    <grapheme>ptp</grapheme>
    <alias>cam kết thanh toán</alias>
  </lexeme>

  <!-- VAD (Voice Activity Detection) -->
  <lexeme>
    <grapheme>VAD</grapheme>
    <alias>vát</alias>
  </lexeme>
  <lexeme>
    <grapheme>vad</grapheme>
    <alias>vát</alias>
  </lexeme>

  <!-- TTS (Text to Speech) -->
  <lexeme>
    <grapheme>TTS</grapheme>
    <alias>ti-ti-ét</alias>
  </lexeme>
  <lexeme>
    <grapheme>tts</grapheme>
    <alias>ti-ti-ét</alias>
  </lexeme>

  <!-- STT (Speech to Text) -->
  <lexeme>
    <grapheme>STT</grapheme>
    <alias>ét-ti-ti</alias>
  </lexeme>
  <lexeme>
    <grapheme>stt</grapheme>
    <alias>ét-ti-ti</alias>
  </lexeme>

  <!-- LLM (Large Language Model) -->
  <lexeme>
    <grapheme>LLM</grapheme>
    <alias>en-en-em</alias>
  </lexeme>
  <lexeme>
    <grapheme>llm</grapheme>
    <alias>en-en-em</alias>
  </lexeme>

  <!-- PCI-DSS -->
  <lexeme>
    <grapheme>PCI-DSS</grapheme>
    <alias>pi-xi-ai đi-ét-ét</alias>
  </lexeme>
  <lexeme>
    <grapheme>pci-dss</grapheme>
    <alias>pi-xi-ai đi-ét-ét</alias>
  </lexeme>

  <!-- FCR (First Contact Resolution) -->
  <lexeme>
    <grapheme>FCR</grapheme>
    <alias>ét-xi-a</alias>
  </lexeme>
  <lexeme>
    <grapheme>fcr</grapheme>
    <alias>ét-xi-a</alias>
  </lexeme>

  <!-- MOS (Mean Opinion Score) -->
  <lexeme>
    <grapheme>MOS</grapheme>
    <alias>mót</alias>
  </lexeme>
  <lexeme>
    <grapheme>mos</grapheme>
    <alias>mót</alias>
  </lexeme>

  <!-- QC (Quality Control) -->
  <lexeme>
    <grapheme>QC</grapheme>
    <alias>kiu-xi</alias>
  </lexeme>
  <lexeme>
    <grapheme>qc</grapheme>
    <alias>kiu-xi</alias>
  </lexeme>

</lexicon>
